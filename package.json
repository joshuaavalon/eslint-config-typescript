{
  "name": "@joshuaavalon/eslint-config-typescript",
  "version": "11.1.2",
  "description": "Shareable ESLint Typescript config.",
  "type": "module",
  "module": "./dist/index.d.ts",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "eslint src",
    "prebuild": "rimraf dist",
    "build": "tsc",
    "inspect": "eslint-config-inspector"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "keywords": [
    "eslint",
    "eslintconfig"
  ],
  "files": [
    "dist"
  ],
  "author": "Joshua Avalon",
  "license": "Apache-2.0",
  "homepage": "https://github.com/joshuaavalon/eslint-config-typescript#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joshuaavalon/eslint-config-typescript.git"
  },
  "bugs": {
    "url": "https://github.com/joshuaavalon/eslint-config-typescript/issues"
  },
  "dependencies": {
    "@joshuaavalon/eslint-config-javascript": "^11.1.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint-plugin-perfectionist": "^5.10.0",
    "typescript-eslint": "^8.63.0"
  },
  "devDependencies": {
    "@eslint/config-inspector": "^3.0.4",
    "@eslint/core": "^1.2.1",
    "@typescript-eslint/utils": "^8.63.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "globals": "^17.7.0",
    "rimraf": "^6.1.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "peerDependencies": {
    "eslint": ">=10.4.1"
  }
}
